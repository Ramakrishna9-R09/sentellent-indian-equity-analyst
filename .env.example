# Copy to .env for Docker Compose local development. Do not commit real secrets.
POSTGRES_DB=sentellent
POSTGRES_USER=sentellent
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+psycopg://sentellent:change-me-locally@postgres:5432/sentellent

# A local-only sign-in bypass. Set false for any shared deployment.
DEV_BYPASS_AUTH=true
DEV_USER_EMAIL=demo@example.com
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=sentellent_session

# Google OAuth. Required when DEV_BYPASS_AUTH=false.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Optional LLM / embeddings. Production must set these through AWS Secrets Manager.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Source adapters
SOURCE_USER_AGENT=SentellentAssessmentBot/1.0 (research demo; contact: candidate@example.com)
NEWS_FEED_URLS=https://economictimes.indiatimes.com/markets/rssfeeds/1977021501.cms,https://www.moneycontrol.com/rss/MCtopnews.xml
NEWS_LOOKBACK_DAYS=14
FUNDAMENTALS_REFRESH_HOURS=168
NEWS_REFRESH_HOURS=24
PRICE_REFRESH_HOURS=6
SOURCE_ARCHIVE_BUCKET=
AWS_REGION=ap-south-1

# Next.js client
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
